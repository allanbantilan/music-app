{
  "expo": {
    "name": "YT Music Clone",
    "slug": "ytmusic-clone",
    "version": "1.0.0",
    "scheme": "ytmusic",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#030303"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.allandev123.ytmusicclone",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#030303"
      },
      "package": "com.allandev123.ytmusicclone",
      "permissions": ["FOREGROUND_SERVICE", "FOREGROUND_SERVICE_MEDIA_PLAYBACK"],
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-router",
      "./plugins/withOkHttpIpv4Dns"
    ],
    "extra": {
      "eas": {
        "projectId": "630df040-8d18-44e5-99d9-2fca3903e3ba"
      },
      "BACKEND_URL": "http://192.168.1.9:8000",
      "TOKEN": "test_token_backend"
    },
    "owner": "allandev123"
  }
}
